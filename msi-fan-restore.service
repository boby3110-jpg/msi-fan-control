[Unit]
Description=MSI ファンカーブと性能モードを起動時に再適用
# WantedBy と同じ multi-user.target を After に置くと循環になり、
# 同じターゲットに紐づく他ユニットのジョブが削除される。
# msi-ec は /etc/modules-load.d/ 経由で読み込まれるのでそこに紐づける。
After=systemd-modules-load.service

[Service]
Type=oneshot
RemainAfterExit=yes
# msi-ec の sysfs が生えるまで最大 30 秒待つ
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /sys/devices/platform/msi-ec/debug/ec_set ] && exit 0; sleep 1; done; exit 1'
ExecStart=/usr/local/bin/msi-fan-helper restore

[Install]
WantedBy=multi-user.target
