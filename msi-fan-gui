            ss = QSpinBox(); ss.setRange(0, 100); ss.setSuffix(" %")
            ts.valueChanged.connect(self.spins_to_curve)
            ss.valueChanged.connect(self.spins_to_curve)
            bl = QLabel("—"); bl.setAlignment(Qt.AlignmentFlag.AlignCenter)
            bf = bl.font(); bf.setPointSize(8); bl.setFont(bf)
            sg.addWidget(ts, 0, i + 1); sg.addWidget(ss, 1, i + 1)
            sg.addWidget(bl, 2, i + 1)
            self.t_spin.append(ts); self.s_spin.append(ss); self.band_lbl.append(bl)
