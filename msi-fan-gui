    QApplication, QCheckBox, QComboBox, QFrame, QGridLayout, QGroupBox, QHBoxLayout,
    QLabel, QMainWindow, QMenu, QMessageBox, QPushButton, QScrollArea, QSizePolicy,
    QSystemTrayIcon,
    QSpinBox, QTabWidget, QVBoxLayout, QWidget,
)

D = "/sys/devices/platform/msi-ec"
POWER_FILE = "/run/msi-fan/power"   # 監視デーモンが公開する実測消費電力
def _find_battery():
    """電池の sysfs パス。BAT0 か BAT1 かは機種で違うので type で探す。"""
    import glob
    for p in sorted(glob.glob("/sys/class/power_supply/*")):
        try:
            with open(f"{p}/type") as f:
                if f.read().strip() == "Battery":
                    return p
        except OSError:
            pass
    return "/sys/class/power_supply/BAT0"


BAT = _find_battery()
# 運用上よく使う充電上限。60=普段、80=外出前、100=残量計の較正時。
CHARGE_PRESETS = [(60, "60% 普段"), (80, "80% 外出前"), (100, "100% 較正")]
# 0xd2 の既定値 0xc0。msi-ec の一覧にないので shift_mode は "unknown (192)"
# と読めるが、実測では turbo と同等だった。
DEFAULT_SHIFT = "デフォルト"
ICON_SIZES = (16, 22, 24, 32, 48, 64, 128, 256, 512)
ICON_DIR = "/usr/share/icons/hicolor/{0}x{0}/apps/msi-fan.png"
HELPER = "/usr/local/bin/msi-fan-helper"
TEMP_ADDRS = [0x6A, 0x6B, 0x6C, 0x6D, 0x6E, 0x6F]
SPEED_ADDRS = [0x72, 0x73, 0x74, 0x75, 0x76, 0x77]

T_MIN, T_MAX = 30, 105

# EC は「現在温度以上で最初に来る温度点」の速度を出す（実測で確認）。
# 最終温度点より上は制御対象外になるため、必ず 100℃ まで覆うこと。
PRESETS = {
    "静音重視":   ([55, 68, 78, 86, 93, 100], [0, 20, 35, 50, 70, 90]),
    "デフォルト": ([50, 60, 70, 80, 90, 95],  [0, 40, 50, 70, 70, 70]),
    "冷却重視":   ([50, 60, 70, 80, 90, 100], [0, 35, 55, 75, 90, 100]),
    # 低温帯でも回し続けて静止状態からの起動を避け、高速側を左に寄せて先回りさせる
    "立ち上がり重視": ([45, 55, 65, 75, 85, 100], [25, 45, 65, 85, 100, 100]),
    # 低負荷は完全停止で無音、高温域だけ全力。自動 Cooler Boost と組で使う想定
    "静音⇄全力":  ([60, 70, 78, 86, 94, 100], [0, 35, 65, 90, 100, 100]),
}


def read_sysfs(name, default="—"):
    try:
        with open(f"{D}/{name}") as f:
            return f.read().strip()
    except OSError:
        return default


def app_icon():
    """インストール済みの PNG を直接読み込む。

    QIcon.fromTheme はプラットフォームテーマが載っていない場面で
    テーマ名を持たず Null を返すことがあり、そうなると
    setWindowIcon が無効になってウィンドウのアイコンが既定のままになる。
    """
    icon = QIcon()
    for sz in ICON_SIZES:
        path = ICON_DIR.format(sz)
        if os.path.exists(path):
            icon.addFile(path, QSize(sz, sz))
    return icon if not icon.isNull() else QIcon.fromTheme("msi-fan")


def read_battery():
    """充電しきい値と電池の状態。

    charge_control_start_threshold は msi-ec 内で end-10 を返すだけの
    派生値なので扱わない。実体のある設定は end 側だけ。
    """
    def n(name):
        try:
            with open(f"{BAT}/{name}") as f:
                return int(f.read().strip())
        except (OSError, ValueError):
            return 0

    try:
        with open(f"{BAT}/status") as f:
            status = f.read().strip()
    except OSError:
        status = "—"
    full, design = n("charge_full"), n("charge_full_design")
    return {
        "charge_now": n("charge_now"),
        "current": n("current_now"),
        "voltage": n("voltage_now"),
        "limit": n("charge_control_end_threshold"),
        "capacity": n("capacity"),
        "status": status,
        "full": full,
        "design": design,
        "health": full / design * 100 if design else 0,
    }


def battery_ring_icon(base, capacity, limit, status):
    """アプリアイコンの周囲に充電率のリングを描いたトレイ用アイコン。

    トレイは 22〜32px で表示されるため、隅に小さな円グラフを置いても潰れる。
    外周をリングにすれば同じ面積でも角度で読める。アプリ内のゲージと同じく
    「充電上限より先」を沈めて描き、60% で止まるのが異常でないことを示す。
    """
    # pen_w を上げるほどリングは読みやすくなるが、その分ベースアイコンが
    # 小さくなる。12/64 が視認性と識別性の折り合い点（実機で確認）。
    size, pen_w = 64, 12
    pm = QPixmap(size, size)
    pm.fill(Qt.GlobalColor.transparent)
    p = QPainter(pm)
    p.setRenderHint(QPainter.RenderHint.Antialiasing)

    inset = pen_w + 2
    base.paint(p, inset, inset, size - 2 * inset, size - 2 * inset)

    rect = QRectF(pen_w / 2 + 1, pen_w / 2 + 1,
                  size - pen_w - 2, size - pen_w - 2)
    top = 90 * 16                      # 12時位置から時計回り

    track = QColor("#8a8a8a"); track.setAlpha(70)
    p.setPen(QPen(track, pen_w, cap=Qt.PenCapStyle.FlatCap))
    p.drawArc(rect, 0, 360 * 16)

    if limit < 100:                    # 充電されない領域
        dead = QColor("#e8663d"); dead.setAlpha(80)
        p.setPen(QPen(dead, pen_w, cap=Qt.PenCapStyle.FlatCap))
        p.drawArc(rect, top - int(360 * 16 * limit / 100),
                  -int(360 * 16 * (100 - limit) / 100))

    if capacity > 0:
        if status == "Charging":
            fill = QColor("#4caf7d")
        elif capacity <= 20:
            fill = QColor("#e8663d")
        else:
            fill = QColor("#3d9ae8")
        p.setPen(QPen(fill, pen_w, cap=Qt.PenCapStyle.FlatCap))
        p.drawArc(rect, top, -int(360 * 16 * capacity / 100))

    p.end()
    return QIcon(pm)


def shift_label(raw):
    """性能モードの表示名。0xc0 は既定値なので unknown ではなくそう見せる。"""
    if raw.startswith("unknown"):
        return DEFAULT_SHIFT if "(192)" in raw else raw
    return (raw.split() or ["—"])[0]


def read_power():
    """CPU の実測消費電力。

    性能モードは RAPL の上限値を書き換えずに実電力を抑えるため、
    上限値を見ても効果が分からない。実測値でしか判定できない。
    energy_uj は root 専用なので、デーモンが公開した値を読む。
    """
    try:
        with open(POWER_FILE) as f:
            return f"{float(f.read().strip()):.1f} W"
    except (OSError, ValueError):
        return "—"


def read_ec_dump():
    """ec_dump を丸ごと読んで {番地: 値} にする。ec_get と違い競合しない。"""
    data = {}
    try:
        with open(f"{D}/debug/ec_dump") as f:
            for line in f:
                m = re.match(r"\|\s*0x([0-9a-f])_\s*\|\s*((?:[0-9a-f]{2}\s+){16})", line)
                if m:
                    hi = int(m.group(1), 16)
                    for lo, v in enumerate(m.group(2).split()):
                        data[hi * 16 + lo] = int(v, 16)
    except OSError:
        pass
    return data


def read_curve():
    d = read_ec_dump()
    if not all(a in d for a in TEMP_ADDRS + SPEED_ADDRS):
        return None
    return [d[a] for a in TEMP_ADDRS], [d[a] for a in SPEED_ADDRS]


def run_helper(*args):
    """pkexec 経由でヘルパーを呼ぶ。成功なら None、失敗ならメッセージを返す。"""
    try:
        p = subprocess.run(["pkexec", HELPER, *args],
                           capture_output=True, text=True, timeout=120)
    except FileNotFoundError:
        return "pkexec が見つかりません（sudo apt install pkexec）"
    except subprocess.TimeoutExpired:
        return "ヘルパーが応答しません"
    if p.returncode == 126:
        return None          # 利用者が認証をキャンセルした
    if p.returncode != 0:
        return p.stderr.strip() or f"終了コード {p.returncode}"
    return None


class BatteryBar(QWidget):
    """0〜100% 固定目盛りの充電ゲージ。

    現在の充電率に加えて充電上限も同じ物差しの上に描く。上限より右は
    「充電されない領域」なので沈めて表示し、なぜ満充電にならないのかが
    一目で分かるようにする。
    """

    def __init__(self):
        super().__init__()
        self.capacity = 0
        self.limit = 100
        self.status = ""
        self.setMinimumHeight(78)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)

    def set_state(self, capacity, limit, status):
        self.capacity, self.limit, self.status = capacity, limit, status
        self.update()

    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        fg = self.palette().windowText().color()
        m, bar_h = 12, 30
        x0, w = m, self.width() - 2 * m
        y0 = 26
        if w <= 0:
            return

        def px(pct):
            return x0 + w * max(0, min(100, pct)) / 100

        track = QColor(fg); track.setAlpha(28)
        p.setPen(Qt.PenStyle.NoPen)
        p.setBrush(track)
        p.drawRoundedRect(x0, y0, w, bar_h, 5, 5)

        # 上限より右＝充電されない領域
        if self.limit < 100:
            dead = QColor("#e8663d"); dead.setAlpha(30)
            p.setBrush(dead)
            p.drawRoundedRect(int(px(self.limit)), y0,
                              int(px(100) - px(self.limit)), bar_h, 5, 5)

        # 充電量
        if self.capacity > 0:
            if self.status == "Charging":
                fill = QColor("#4caf7d")
            elif self.capacity <= 20:
                fill = QColor("#e8663d")
            else:
                fill = QColor("#3d9ae8")
            p.setBrush(fill)
            p.drawRoundedRect(x0, y0, max(6, int(px(self.capacity) - x0)), bar_h, 5, 5)

        # 上限マーカー
        if self.limit < 100:
            xl = int(px(self.limit))
            p.setPen(QPen(QColor("#e8663d"), 2))
            p.drawLine(xl, y0 - 6, xl, y0 + bar_h + 6)
            f = QFont(); f.setPointSize(8); f.setBold(True); p.setFont(f)
            p.drawText(xl + 4, y0 - 10, f"上限 {self.limit}%")

        # 目盛り
        grid = QColor(fg); grid.setAlpha(90)
        f = QFont(); f.setPointSize(8); p.setFont(f)
        for t in (0, 25, 50, 75, 100):
            xt = int(px(t))
            p.setPen(QPen(grid, 1))
            p.drawLine(xt, y0 + bar_h + 2, xt, y0 + bar_h + 6)
            p.drawText(xt - (14 if t == 100 else 6), y0 + bar_h + 20, f"{t}")

        # 現在値
        f = QFont(); f.setPointSize(13); f.setBold(True); p.setFont(f)
        p.setPen(fg)
        p.drawText(x0, y0 - 8, f"{self.capacity}%")


class CurveWidget(QWidget):
    """ドラッグで編集できるファンカーブ。"""
    changed = pyqtSignal()

    def __init__(self):
        super().__init__()
        self.temps = list(PRESETS["デフォルト"][0])
        self.speeds = list(PRESETS["デフォルト"][1])
        self.cur_temp = None
        self.cur_speed = None
        self.drag = None
        self.setMinimumSize(360, 150)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
        self.setMouseTracking(True)

    # --- 座標変換 ---
    def _rect(self):
        m_l, m_r, m_t, m_b = 52, 16, 16, 34
        return m_l, m_t, self.width() - m_l - m_r, self.height() - m_t - m_b

    def _to_px(self, t, s):
        x0, y0, w, h = self._rect()
        return QPointF(x0 + (t - T_MIN) / (T_MAX - T_MIN) * w, y0 + (1 - s / 100) * h)

    def _from_px(self, pos):
        x0, y0, w, h = self._rect()
        t = T_MIN + (pos.x() - x0) / w * (T_MAX - T_MIN)
        s = (1 - (pos.y() - y0) / h) * 100
        return t, s

    # --- 操作 ---
    def mousePressEvent(self, e):
        if e.button() != Qt.MouseButton.LeftButton:
            return
        for i in range(6):
            if (self._to_px(self.temps[i], self.speeds[i]) - e.position()).manhattanLength() < 18:
                self.drag = i
                return

    def mouseReleaseEvent(self, e):
        self.drag = None

    def mouseMoveEvent(self, e):
        if self.drag is None:
            return
        i = self.drag
        t, s = self._from_px(e.position())
        lo = self.temps[i - 1] + 1 if i > 0 else T_MIN
        hi = self.temps[i + 1] - 1 if i < 5 else T_MAX
        self.temps[i] = max(lo, min(hi, round(t)))
        s_lo = self.speeds[i - 1] if i > 0 else 0
        s_hi = self.speeds[i + 1] if i < 5 else 100
        self.speeds[i] = max(s_lo, min(s_hi, round(s)))
        self.changed.emit()
        self.update()

    def set_curve(self, temps, speeds):
        self.temps, self.speeds = list(temps), list(speeds)
        self.update()

    # --- 描画 ---
    def paintEvent(self, _):
        p = QPainter(self)
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        pal = self.palette()
        fg = pal.windowText().color()
        x0, y0, w, h = self._rect()

        grid = QColor(fg); grid.setAlpha(38)
        p.setPen(QPen(grid, 1))
        f = QFont(); f.setPointSize(8); p.setFont(f)
        label = QColor(fg); label.setAlpha(150)
        for s in range(0, 101, 20):
            y = y0 + (1 - s / 100) * h
            p.setPen(QPen(grid, 1)); p.drawLine(int(x0), int(y), int(x0 + w), int(y))
            p.setPen(label); p.drawText(4, int(y) + 4, f"{s:3d} %")
        for t in range(30, 106, 10):
            x = x0 + (t - T_MIN) / (T_MAX - T_MIN) * w
            p.setPen(QPen(grid, 1)); p.drawLine(int(x), int(y0), int(x), int(y0 + h))
            p.setPen(label); p.drawText(int(x) - 12, int(y0 + h) + 18, f"{t}℃")

        # 最終温度点より上は EC のカーブが効かない領域（実測で確認）
        if self.temps[5] < T_MAX:
            xu = self._to_px(self.temps[5], 0).x()
            warn = QColor("#e8663d"); warn.setAlpha(45)
            p.fillRect(int(xu), int(y0), int(x0 + w - xu), int(h), warn)
            p.setPen(QColor("#e8663d"))
            p.drawText(int(xu) + 6, int(y0 + h) - 6, "制御対象外")

        # 現在温度
        if self.cur_temp is not None and T_MIN <= self.cur_temp <= T_MAX:
            x = self._to_px(self.cur_temp, 0).x()
            hot = QColor("#e8663d")
            p.setPen(QPen(hot, 2))
            p.drawLine(int(x), int(y0), int(x), int(y0 + h))
            p.drawText(int(x) + 5, int(y0) + 13, f"{self.cur_temp}℃")

        # 報告回転数
        if self.cur_speed is not None:
            y = self._to_px(0, self.cur_speed).y()
            c = QColor("#3d9ae8")
            p.setPen(QPen(c, 1, Qt.PenStyle.DashLine))
            p.drawLine(int(x0), int(y), int(x0 + w), int(y))

        # カーブ。EC は「現在温度の次にある温度点」の速度を使うので階段状に描く。
        # つまり speed[i] が効くのは temp[i-1] 以上 temp[i] 未満の区間。
        accent = QColor("#4caf7d")
        left = T_MIN
        for i in range(6):
            y = self._to_px(0, self.speeds[i]).y()
            xa = self._to_px(left, 0).x()
            xb = self._to_px(self.temps[i], 0).x()
            p.setPen(QPen(accent, 2))
            p.drawLine(int(xa), int(y), int(xb), int(y))
            if i < 5:
                y2 = self._to_px(0, self.speeds[i + 1]).y()
                p.drawLine(int(xb), int(y), int(xb), int(y2))
            left = self.temps[i]
        # 最終点より上の温度域は挙動未確認のため点線
        y = self._to_px(0, self.speeds[5]).y()
        p.setPen(QPen(accent, 2, Qt.PenStyle.DotLine))
        p.drawLine(int(self._to_px(self.temps[5], 0).x()), int(y),
                   int(self._to_px(T_MAX, 0).x()), int(y))
        for i in range(6):
            pt = self._to_px(self.temps[i], self.speeds[i])
            p.setBrush(accent if self.drag != i else QColor("#ffffff"))
            p.setPen(QPen(accent, 2))
            p.drawEllipse(pt, 6, 6)


class MainWindow(QMainWindow):
