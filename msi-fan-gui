        self.setWindowTitle("MSI ファン制御 — Prestige 13Evo A12M")
        root = QWidget()
        outer = QVBoxLayout(root)

        # 状態表示
        box = QGroupBox("現在の状態")
        g = QGridLayout(box)
        self.lbl = {}
        items = [("温度", "temp"), ("報告回転", "fan"), ("ファンモード", "mode"),
                 ("Cooler Boost", "boost"), ("性能モード", "shift"),
                 ("消費電力", "power")]
        for col, (title, key) in enumerate(items):
            cap = QLabel(title); cap.setAlignment(Qt.AlignmentFlag.AlignCenter)
            capf = cap.font(); capf.setPointSize(8); cap.setFont(capf)
