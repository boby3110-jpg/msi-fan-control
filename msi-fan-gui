        tabs = QTabWidget()
        fan_page = QWidget(); fan = QVBoxLayout(fan_page)
        bat_page = QWidget(); bat = QVBoxLayout(bat_page)
        tabs.addTab(fan_page, "ファン")
        tabs.addTab(bat_page, "バッテリー")
        outer.addWidget(tabs)

        # カーブ
        cbox = QGroupBox("ファンカーブ — 各段は「その温度に達するまでの区間で出す速度」")
        cl = QVBoxLayout(cbox)
        self.curve = CurveWidget()
        self.curve.changed.connect(self.curve_to_spins)
        cl.addWidget(self.curve)

