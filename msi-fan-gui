#!/usr/bin/env python3
"""MSI ファン制御 GUI — MSI Prestige 13 Evo A12M (EC 13Q1EMS1) 向け

⚠️ ファンカーブの読み書きは msi-ec が公開していない EC の生レジスタ
（0x6a-0x6f / 0x72-0x77）に対して行う。番地の配置は上記機種でのみ実測で
確認している。他機種では msi-fan-helper が機種ガードで拒否する。

読み取りは sysfs から直接（無権限）。書き込みのみ pkexec でヘルパーに委譲する。
Wayland では root で GUI を起動できないため、この分離が必要。
"""
import json
import os
import statistics
from collections import deque
import re
import subprocess
import sys

from PyQt6.QtCore import QRectF, QSize, Qt, QTimer, pyqtSignal
from PyQt6.QtGui import QAction, QColor, QFont, QIcon, QPainter, QPen, QPixmap
