    # --- 同期 ---
    # --- システムトレイ ---
    def build_tray(self):
        self.base_icon = app_icon()
        self.tray_key = None           # 同じ絵を作り直さないための前回値
        self.tray = QSystemTrayIcon(self.base_icon, self)
        menu = QMenu()

        self.act_show = QAction("ウィンドウを表示", self)
        self.act_show.triggered.connect(self.toggle_window)
        menu.addAction(self.act_show)
        menu.addSeparator()

        self.act_boost = QAction("Cooler Boost", self, checkable=True)
        self.act_boost.triggered.connect(
            lambda on: self.set_mode("cooler_boost", "on" if on else "off"))
        menu.addAction(self.act_boost)

        shift_menu = menu.addMenu("性能モード")
        self.shift_acts = {}
        for name in [DEFAULT_SHIFT] + read_sysfs("available_shift_modes", "").split():
            a = QAction(name, self, checkable=True)
            a.triggered.connect(lambda _, v=name: self.tray_set_shift(v))
            shift_menu.addAction(a)
            self.shift_acts[name] = a

        menu.addSeparator()
        quit_act = QAction("終了", self)
        quit_act.triggered.connect(QApplication.quit)
        menu.addAction(quit_act)

        self.tray.setContextMenu(menu)
        self.tray.activated.connect(
            lambda r: self.toggle_window()
            if r == QSystemTrayIcon.ActivationReason.Trigger else None)
        self.tray.show()

    def toggle_window(self):
        if self.isVisible() and not self.isMinimized():
            self.hide()
        else:
            self.showNormal()
            self.raise_()
            self.activateWindow()

    def tray_set_shift(self, val):
        if val == DEFAULT_SHIFT:
            err = run_helper("shift_reset")
        else:
            err = run_helper("shift_mode", val)
        if err:
            self.tray.showMessage("失敗", err, QSystemTrayIcon.MessageIcon.Warning)

    def closeEvent(self, e):
        """× ではアプリを終了せず、トレイへ格納する。終了はトレイのメニューから。"""
        if self.tray.isVisible():
            e.ignore()
            self.hide()
        else:
            e.accept()

    def curve_to_spins(self):
        for i in range(6):
            self.t_spin[i].blockSignals(True); self.s_spin[i].blockSignals(True)
            self.t_spin[i].setValue(self.curve.temps[i])
            self.s_spin[i].setValue(self.curve.speeds[i])
            self.t_spin[i].blockSignals(False); self.s_spin[i].blockSignals(False)
        self.update_bands()

    def spins_to_curve(self):
        self.curve.temps = [w.value() for w in self.t_spin]
        self.curve.speeds = [w.value() for w in self.s_spin]
        self.curve.update()
        self.update_bands()

    def update_bands(self):
        t = self.curve.temps
        for i in range(6):
            self.band_lbl[i].setText(
                f"〜{t[0]}℃" if i == 0 else f"{t[i - 1]}〜{t[i]}℃")

    def load_preset(self, name):
        self.curve.set_curve(*PRESETS[name])
        self.curve_to_spins()

    def reload_curve(self):
        c = read_curve()
        if c is None:
            QMessageBox.warning(self, "読み取り失敗",
                                "EC を読めません。msi-ec が debug モードで\n"
                                "読み込まれているか確認してください。")
            return
        self.curve.set_curve(*c)
        self.curve_to_spins()

    # --- 書き込み ---
    def apply(self, save):
        if self.curve.temps[5] < 100:
            if QMessageBox.warning(
                self, "最終温度点が低すぎます",
                f"最終温度点が {self.curve.temps[5]}℃ になっています。\n\n"
                "これより上の温度域は EC のカーブ制御から外れ、既定動作"
                "（実測では 70%）に戻ります。その状態では Cooler Boost も"
                "効かなくなることを確認しています。\n\n"
                "本機の Tjmax は 100℃ で、性能モードが デフォルト / turbo の"
                "ときは実測で 95℃ に張り付きます。穴を残さないために最終温度点は"
                "100℃ にしておくことを強く勧めます。\n\nこのまま適用しますか？",
                QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No,
                QMessageBox.StandardButton.No,
            ) != QMessageBox.StandardButton.Yes:
                return
        payload = json.dumps({"temps": self.curve.temps,
                              "speeds": self.curve.speeds, "save": save})
        err = run_helper("apply", payload)
        if err:
            QMessageBox.critical(self, "適用できませんでした", err)
        else:
            self.reload_curve()

    def to_stock(self):
        if QMessageBox.question(
                self, "確認",
                "カーブをデフォルト (50/60/70/80/90/95℃ → 0/40/50/70/70/70%) に戻し、\n"
                "起動時の自動適用も解除します。よろしいですか？"
        ) != QMessageBox.StandardButton.Yes:
            return
        err = run_helper("stock")
        if err:
            QMessageBox.critical(self, "失敗", err)
        self.reload_curve()

    def load_autoboost(self):
        try:
            with open("/etc/msi-fan/autoboost.json") as f:
                c = json.load(f)
        except (OSError, ValueError):
            c = {}
        self.ab_enable.setChecked(bool(c.get("enabled", False)))
        self.ab_on.setValue(int(c.get("on_temp", 85)))
        self.ab_off.setValue(int(c.get("off_temp", 70)))

    def apply_autoboost(self):
        if self.ab_off.value() >= self.ab_on.value():
            QMessageBox.warning(self, "設定が不正です",
                                "解除温度は作動温度より低くしてください。")
            return
        err = run_helper("autoboost", json.dumps({
            "enabled": self.ab_enable.isChecked(),
            "on_temp": self.ab_on.value(),
            "off_temp": self.ab_off.value()}))
        if err:
            QMessageBox.critical(self, "失敗", err)

    def toggle_boost(self):
        want = "on" if self.boost_btn.isChecked() else "off"
        err = run_helper("cooler_boost", want)
        if err:
            QMessageBox.critical(self, "失敗", err)

    def set_charge_limit(self, value):
        err = run_helper("charge_limit", str(value))
        if err:
            QMessageBox.critical(self, "失敗", err)

    def on_shift_selected(self):
        val = self.shift_combo.currentText()
        if val == DEFAULT_SHIFT:
            err = run_helper("shift_reset")   # 0xd2 に 0xc0 を書き戻す専用経路
        else:
            err = run_helper("shift_mode", val)
        if err:
            QMessageBox.critical(self, "失敗", err)

    def set_mode(self, attr, val):
        err = run_helper(attr, val)
        if err:
            QMessageBox.critical(self, "失敗", err)

    @staticmethod
    def _sync_combo(combo, value):
        """操作中でなければ、コンボの選択を実際の状態に合わせる。"""
        if combo.hasFocus():
            return
        i = combo.findText(value)
        if i >= 0 and i != combo.currentIndex():
            combo.setCurrentIndex(i)

    # --- 定期更新 ---
    def refresh(self):
        t = read_sysfs("cpu/realtime_temperature")
        s = read_sysfs("cpu/realtime_fan_speed")
        boost = read_sysfs("cooler_boost")
        self.lbl["temp"].setText(f"{t} ℃")
        self.lbl["fan"].setText(f"{s} %")
        self.lbl["mode"].setText(read_sysfs("fan_mode"))
        self.lbl["boost"].setText("ON" if boost == "on" else "off")
        shift = shift_label(read_sysfs("shift_mode"))
        self.lbl["shift"].setText(shift)
        self._sync_combo(self.shift_combo, shift)
        self._sync_combo(self.fan_combo, read_sysfs("fan_mode"))
        self.lbl["power"].setText(read_power())

        b = read_battery()
        self.bar.set_state(b["capacity"], b["limit"] or 100, b["status"])
        st = {"Charging": "充電中", "Discharging": "放電中",
              "Not charging": "充電停止（上限に到達）", "Full": "満充電"}.get(
                  b["status"], b["status"])
        self.bat_state.setText(f"{st}")
        if b["design"]:
            self.bat_health.setText(
                f"満充電容量 {b['full']/1000:.0f} mAh / 設計 {b['design']/1000:.0f} mAh"
                f"　→　健全度 {b['health']:.1f}%")
        if not self.chg_spin.hasFocus() and b["limit"]:
            self.chg_spin.setValue(b["limit"])

        self.lbl["temp"].setStyleSheet(
            "color:#e8663d" if t.isdigit() and int(t) >= 85 else "")
        on = boost == "on"
        self.lbl["boost"].setStyleSheet("color:#e8663d" if on else "")
        self.boost_btn.setText("Cooler Boost 作動中（押すと切る）" if on
                               else "Cooler Boost を入れる")
        self.boost_btn.setStyleSheet(
            "font-weight:bold; color:#e8663d" if on else "")
        self.boost_btn.setToolTip(
            "自動 Cooler Boost が有効なので、しきい値を跨ぐと"
            "この手動操作は上書きされます"
            if self.ab_enable.isChecked() else
            "ファンをカーブの 100% よりさらに上で回します（効き始めまで約20秒）")
        if t.isdigit():
            self.curve.cur_temp = int(t)
        if s.isdigit():
            self.curve.cur_speed = int(s)
        self.curve.update()
        if not self.boost_btn.isDown():
            self.boost_btn.setChecked(on)

        self.update_tray(t, s, shift, b, boost)

    def runtime_text(self, b):
        """残り稼働時間。charge_now / current_now で求まるが、瞬時電流は
        揺れが大きいので直近サンプルの中央値を使う。"""
        if b["status"] != "Discharging":
            return None
        if b["current"] > 0:
            self.current_hist.append(b["current"])
        if len(self.current_hist) < 3:
            return "計測中…"
        cur = statistics.median(self.current_hist)
        if cur <= 0 or not b["charge_now"]:
            return None
        h = b["charge_now"] / cur
        return f"{int(h)}時間{int((h % 1) * 60):02d}分"

    def update_tray(self, temp, fan, shift, b, boost):
        st = {"Charging": "充電中", "Discharging": "放電中",
              "Not charging": "充電停止", "Full": "満充電"}.get(b["status"], b["status"])
        lines = [
            "MSI ファン制御",
            f"CPU {temp}℃ / ファン {fan}%" + ("  [Boost]" if boost == "on" else ""),
            f"性能 {shift} / 消費 {read_power()}",
            f"電池 {b['capacity']}%（{st}）",
        ]
        rt = self.runtime_text(b)
        if rt:
            lines.append(f"残り 約{rt}")
        else:
            lines.append(f"充電上限 {b['limit']}%")
        self.tray.setToolTip("\n".join(lines))

        # 値が変わったときだけアイコンを描き直す（毎秒作り直すと無駄）
        key = (b["capacity"], b["limit"] or 100, b["status"])
        if key != self.tray_key:
            self.tray_key = key
            self.tray.setIcon(battery_ring_icon(self.base_icon, *key))

        if self.act_boost.isChecked() != (boost == "on"):
            self.act_boost.setChecked(boost == "on")
        for name, a in self.shift_acts.items():
            a.setChecked(name == shift)
        self.act_show.setText("ウィンドウを隠す" if self.isVisible() else "ウィンドウを表示")


