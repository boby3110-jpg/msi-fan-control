        self.btn_reload = QPushButton("EC から再読込")
        self.btn_apply.clicked.connect(lambda: self.apply(save=False))
        self.btn_save.clicked.connect(lambda: self.apply(save=True))
        self.btn_stock.clicked.connect(self.to_stock)
        self.btn_reload.clicked.connect(self.reload_curve)
        for b in (self.btn_apply, self.btn_save, self.btn_stock, self.btn_reload):
            act.addWidget(b)
